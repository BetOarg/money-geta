From money-geta
Subject: [PATCH] secrets-map: require source URL and dated verification evidence

Audited upstream base: Bodila51/gtavi-claudecode scripts/secrets_map.py
Audited blob: 1d2b50963c3a2f4986911449679809d7390a4c09

Pinned to the audited source; re-check the blob before applying.

diff --git a/scripts/secrets_map.py b/scripts/secrets_map.py
index 1d2b50963c3a2f4986911449679809d7390a4c09..0000000 100644
--- a/scripts/secrets_map.py
+++ b/scripts/secrets_map.py
@@ -163,11 +163,13 @@
 def cmd_verify(a):
     p = csv_path(a)
     rows = load_rows(p)
     r = find_row(rows, a.id)
     if r["status"] == "wrong":
         sys.exit(f"{r['id']} is marked wrong; edit the csv by hand if that is a mistake")
-    if not (r["where"] and r["how"] and r["source_channel"]):
-        sys.exit(f"{r['id']} needs where, how and source_channel filled in before it can be verified")
+    if not (r["where"] and r["how"] and r["source_channel"] and r["source_url_with_timestamp"]):
+        sys.exit(f"{r['id']} needs where, how, source_channel and source_url_with_timestamp before it can be verified")
+    if not re.search(r"\b20\d{2}-\d{2}-\d{2}\b", a.by) or len(a.by.strip()) < 20:
+        sys.exit("verification evidence must include an ISO date (YYYY-MM-DD) and describe the in-game test or official source")
     r["status"], r["verified_by"] = "verified", a.by
