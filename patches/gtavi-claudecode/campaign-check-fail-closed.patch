From money-geta
Subject: [PATCH] check: reject missing or incomplete campaign rules

Audited upstream base: Bodila51/gtavi-claudecode scripts/check.py
Audited blob: c71ad730e009e4a5b5aea113a34e20dabd37620b

Pinned to the audited source; re-check the blob before applying.

diff --git a/scripts/check.py b/scripts/check.py
index 0000000..0000000 100644
--- a/scripts/check.pyscripts/check.py
+++ b/scripts/check.py
@@ -21,4 +21,7 @@
     m = re.search(r"min_seconds:\s*(\d+(?:\.\d+)?)", txt, re.I)
-    if m: rules["min"] = float(m.group(1))
+    if not m: return rules, False
+    rules["min"] = float(m.group(1))
     m = re.search(r"max_seconds:\s*(\d+(?:\.\d+)?)", txt, re.I)
-    if m: rules["max"] = float(m.group(1))
+    if not m: return rules, False
+    rules["max"] = float(m.group(1))
+    if rules["min"] <= 0 or rules["max"] < rules["min"]: return rules, False
@@ -58,1 +61,6 @@
     rules, have_campaign = parse_campaign(a.campaign)
+    if not have_campaign:
+        print("RESULT: INCOMPLETE")
+        print("Campaign rules are missing or incomplete; refusing to approve this clip.")
+        print("Provide valid min_seconds and max_seconds in the campaign file.")
+        sys.exit(2)
     p = ffprobe(clip)
@@ -81,3 +88,0 @@
-    if not have_campaign:
-        add("campaign rules file", True, "none given, defaults used (NOT a rules check)")
-
